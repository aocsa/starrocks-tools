diff --git a/experimental/starrocks/benchmarks/tpch/bench.sh b/experimental/starrocks/benchmarks/tpch/bench.sh
index fbc95b97..49a2fa22 100755
--- a/experimental/starrocks/benchmarks/tpch/bench.sh
