+    @Test
+    public void testTableFunctionTableScanRowCount() throws Exception {
+        // fake:// lists 1024 + 2048 B with the file schema col_int INT, col_string VARCHAR (no columns_from_path).
+        Map<String, String> props = new HashMap<>();
+        props.put("path", "fake://a/*");
+        props.put("format", "parquet");
+        TableFunctionTable table = new TableFunctionTable(props);
+        Map<ColumnRefOperator, Column> refToColumn = Maps.newHashMap();
+        Map<Column, ColumnRefOperator> columnToRef = Maps.newHashMap();
+        List<Column> columns = table.getFullSchema();
+        for (int i = 0; i < columns.size(); i++) {
+            Column column = columns.get(i);
+            ColumnRefOperator ref = new ColumnRefOperator(i, column.getType(), column.getName(), true);
+            refToColumn.put(ref, column);
+            columnToRef.put(column, ref);
+        }
+
+        // 3072 B / (4 + 16) B per row; every column statistic stays unknown, so the compute size prices
+        // the row by type widths.
+        Statistics stats = estimateScan(new LogicalTableFunctionTableScanOperator(table, refToColumn, columnToRef, -1, null));
+        Assertions.assertEquals(153, stats.getOutputRowCount(), 0.001);
+        for (ColumnRefOperator ref : refToColumn.keySet()) {
+            Assertions.assertTrue(stats.getColumnStatistic(ref).isUnknown(), ref.toString());
+        }
+        Assertions.assertTrue(stats.isTableRowCountMayInaccurate());
+        Assertions.assertEquals(153 * 20, stats.getComputeSize(), 0.001);
+
+        // visitOperator still runs after the leaf estimate: a limit caps the row count.
